rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
          && request.auth.token.email in ['noktailetisim39@gmail.com'];
    }

    match /tickets/{id} {
      allow read, write: if isAdmin();
    }

    match /meta/{id} {
      allow read, write: if isAdmin();
    }

    match /public/{id} {
      allow get: if true;
      allow list, write: if isAdmin();
    }

    match /lookup/{id} {
      allow get: if true;
      allow list, write: if isAdmin();
    }

    // Tekniker oturumları (bağlı cihazlar) -> yalnız yönetici
    match /sessions/{sid} {
      allow read, write: if isAdmin();
    }

    // Çevrimiçi ziyaretçi sayacı: herkes yalnız anonim sayaç kaydı yazabilir; okumak yalnız yönetici
    match /presence/{vid} {
      allow create, update: if vid.matches('^[A-Za-z0-9]{6,20}$')
        && request.resource.data.keys().hasOnly(['t', 'p', 'dev'])
        && request.resource.data.t is number
        && request.resource.data.p is string && request.resource.data.p.size() < 30
        && request.resource.data.dev is string && request.resource.data.dev.size() < 10;
      allow read, delete: if isAdmin();
    }

    match /visits/{vid} {
      allow create: if vid.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}_[A-Za-z0-9]{6,20}$')
        && request.resource.data.keys().hasOnly(['d', 't', 'dev', 'p'])
        && request.resource.data.d is string && request.resource.data.d.size() == 10
        && request.resource.data.t is number
        && request.resource.data.dev is string && request.resource.data.dev.size() < 10
        && request.resource.data.p is string && request.resource.data.p.size() < 30;
      allow read, delete: if isAdmin();
    }

    // Servis talepleri: herkes yeni talep yazar, yalnız yönetici okur/günceller/siler
    match /requests/{rid} {
      allow create: if rid.matches('^[A-Za-z0-9]{10,24}$')
        && request.resource.data.keys().hasOnly(['n', 'p', 'd', 'm', 'ts', 'st'])
        && request.resource.data.st == 'yeni'
        && request.resource.data.n is string && request.resource.data.n.size() >= 2 && request.resource.data.n.size() <= 80
        && request.resource.data.p is string && request.resource.data.p.size() >= 10 && request.resource.data.p.size() <= 20
        && request.resource.data.d is string && request.resource.data.d.size() >= 2 && request.resource.data.d.size() <= 100
        && request.resource.data.m is string && request.resource.data.m.size() >= 2 && request.resource.data.m.size() <= 600
        && request.resource.data.ts is number
        && request.resource.data.ts > request.time.toMillis() - 600000
        && request.resource.data.ts < request.time.toMillis() + 600000;
      allow read, update, delete: if isAdmin();
    }

    // Müşteri yorumları: herkes yazar (onay bekler), yalnız yönetici onaylar/siler
    match /reviews/{rid} {
      allow read: if resource.data.get('ok', false) == true || isAdmin();
      allow create: if rid.matches('^[A-Za-z0-9]{10,24}$')
        && request.resource.data.keys().hasOnly(['n', 'r', 't', 'ts', 'ok'])
        && request.resource.data.ok == false
        && request.resource.data.n is string && request.resource.data.n.size() >= 2 && request.resource.data.n.size() <= 30
        && request.resource.data.r is int && request.resource.data.r >= 1 && request.resource.data.r <= 5
        && request.resource.data.t is string && request.resource.data.t.size() >= 5 && request.resource.data.t.size() <= 400
        && request.resource.data.ts is number;
      allow update: if isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ok']);
      allow delete: if isAdmin();
    }
  }
}
